# ─────────────────────────────────────────────────────────────────────────────
# Priority Chat — environment configuration
#
# Copy this file to `.env.local` (same folder) and fill in your values.
# `.env.local` is gitignored and stays on your machine — never commit secrets.
#
# With NOTHING set here, the app runs in DEMO mode (built-in mock data).
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Data source (required to leave demo mode) ────────────────────────────
# Your Priority OData service root. Format:
#   https://{domain}/odata/Priority/{tabula.ini}/{company}
# Ask your Priority admin/partner, or check the REST API settings in Priority.
PRIORITY_ODATA_URL=

# Max rows any single query may return (read-only safety cap).
PRIORITY_MAX_TOP=50

# ── 2. Authentication — pick ONE of the options below ───────────────────────

# ── Option A: API username + password (Basic auth — simplest) ───────────────
# The API User Name defined in the Personnel File form in Priority (this is
# separate from the regular Priority login name), plus its password.
PRIORITY_API_USERNAME=
PRIORITY_API_PASSWORD=

# ── Option B: Personal Access Token (Priority v19.1+) ───────────────────────
# Created by the admin in the "REST Interface Access Tokens" form in Priority.
PRIORITY_PAT=

# ── Option C: OAuth2 sign-in (each user logs in with their own account) ─────
# The OIDC issuer is usually your Priority domain (the app appends
#   /accounts/.well-known/openid-configuration to discover the endpoints).
PRIORITY_OIDC_ISSUER=
# The OAuth client (application) ID registered in Priority.
# Register the redirect URI:  http://localhost:3000/api/auth/callback
PRIORITY_OAUTH_CLIENT_ID=
PRIORITY_OAUTH_SCOPE=openid profile offline_access
# Public base URL of THIS app (used to build the redirect URI).
APP_BASE_URL=http://localhost:3000
# Random secret (>= 32 chars) used to encrypt the session cookie.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Option D: raw bearer token (advanced/testing) ───────────────────────────
PRIORITY_ACCESS_TOKEN=

# ── 3. Optional AI layer (free-text questions in Hebrew/English) ────────────
# With a key from https://console.anthropic.com, Claude maps free-form
# questions to the right query. Privacy: Claude sees ONLY the question and the
# query catalogue — never your ERP data. Without a key, built-in Hebrew/English
# keyword matching is used instead.
ANTHROPIC_API_KEY=
# Model for question routing (default: claude-opus-4-8).
CLAUDE_MODEL=
